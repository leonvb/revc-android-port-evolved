const char *modernPed_frag_src =
"uniform sampler2D tex0;\n"
"FSIN vec4 v_color;\n"
"FSIN vec2 v_tex0;\n"
"FSIN float v_fog;\n"
"void main(void)\n"
"{\n"
"    vec4 tex = texture(tex0, vec2(v_tex0.x, 1.0-v_tex0.y));\n"
"    vec4 color = v_color * tex;\n"
"    color.rgb += tex.rgb * modernLocalLighting();\n"
"    color.rgb = mix(u_fogColor.rgb, color.rgb, v_fog);\n"
"    DoAlphaTest(color.a);\n"
"    FRAGCOLOR(color);\n"
"}\n"
;
